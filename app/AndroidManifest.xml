<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.kishore.quiettv" android:versionCode="23" android:versionName="1.22">
<uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30"/>
<uses-feature android:name="android.software.leanback" android:required="false"/>
<uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
<uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
<application android:label="Quiet TV" android:icon="@drawable/icon" android:banner="@drawable/banner" android:theme="@style/QuietTheme" android:hardwareAccelerated="true" android:allowBackup="false">
<activity android:name=".HomeActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTask">
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
</activity>
<service android:name=".SleepService" android:label="Quiet TV Sleep" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
<intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
<meta-data android:name="android.accessibilityservice" android:resource="@xml/sleep_service"/>
</service></application></manifest>
